SINGLE_SHOT_SECONDS = 5  # a lone shot's tray closes by itself; a pile waits for you


# ---- image work (pure; runs off the UI thread) ------------------------------


def magick_output_args(ext):
    args = []
    if ext == "jpg":  # no alpha in JPEG: flatten onto white, not black
        args += ["-background", "white", "-alpha", "remove", "-alpha", "off"]
    if ext in QUALITY:
        args += ["-quality", QUALITY[ext]]
    return args


def run_magick(args):
    subprocess.run(["magick", *args], check=True, capture_output=True)


def unique_path(path):
    if not path.exists():
        return path
    for n in range(2, 1000):
        candidate = path.with_name(f"{path.stem}-{n}{path.suffix}")
        if not candidate.exists():
            return candidate
    raise FileExistsError(path)


def convert(src, out):
    """Write src to out in out's format. A PNG-to-PNG 'conversion' is a copy."""
    if src.suffix.lower() == out.suffix.lower() == ".png":
        shutil.copy2(src, out)
    else:
        run_magick([str(src), *magick_output_args(out.suffix[1:]), str(out)])
    return out


def stitch(shots, layout, out):
    ext = out.suffix[1:]
    background = "white" if ext == "jpg" else "none"
    files = [str(s) for s in shots]
    if layout == "grid":
        cols = math.ceil(math.sqrt(len(files)))
        args = ["montage", *files, "-tile", f"{cols}x", "-geometry", f"+{GAP}+{GAP}", "-background", background]
    else:
        args = [*files, "-bordercolor", background, "-border", str(GAP // 2),
                "-background", background, "-gravity", "center",
                "-append" if layout == "vertical" else "+append"]
    run_magick([*args, *magick_output_args(ext), str(out)])
    return out


def theme_colors():
    """Two colours from the current Omarchy theme for Beautify's gradient."""
    colors = {}
    try:
        for line in THEME_COLORS.read_text().splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                colors[key.strip()] = value.strip().strip('"')
    except OSError:
        pass
    return colors.get("accent", "#89a9c2"), colors.get("magenta", "#aea0bd")


def image_size(path):
    out = subprocess.run(["magick", "identify", "-format", "%w %h", f"{path}[0]"],
                         check=True, capture_output=True, text=True).stdout.split()
    return int(out[0]), int(out[1])


def beautify(src, out):
    """CleanShot/Shottr-style backdrop: rounded corners, a soft shadow, and the
    shot centred on a gradient in the current theme's colours."""
    work = out.with_suffix(".work.png")
    w, h = image_size(src)
    if w > 2560:  # a 4K shot took ~5 s; at 2560 wide it is crisp and ~3x faster
        small = out.with_suffix(".small.png")
        run_magick([str(src), "-resize", "2560x", str(small)])
        src, (w, h) = small, image_size(small)
    radius = max(8, min(w, h) // 60)
    run_magick([str(src), "-alpha", "set",
                "(", "-size", f"{w}x{h}", "xc:none", "-fill", "white",
                "-draw", f"roundrectangle 0,0 {w - 1},{h - 1} {radius},{radius}", ")",
                "-compose", "DstIn", "-composite",
                "(", "+clone", "-background", "black", "-shadow", "45x18+0+14", ")",
                "+swap", "-background", "none", "-compose", "Over", "-layers", "merge", "+repage",
                str(work)])
    sw, sh = image_size(work)
    pad = max(48, round(max(w, h) * 0.07))
    first, second = theme_colors()
    run_magick(["-size", f"{sw + 2 * pad}x{sh + 2 * pad}", "-define", "gradient:angle=135",
                f"gradient:{first}-{second}", str(work), "-gravity", "center",
                "-compose", "Over", "-composite", str(out)])
    work.unlink(missing_ok=True)
    out.with_suffix(".small.png").unlink(missing_ok=True)
    return out


def ocr_text(path, work):
    """Text in a screenshot. Upscaled 2x first: tesseract reads UI-sized text
    far better at double size."""
    big = work / f"{path.stem}-ocr.png"
    run_magick([str(path), "-colorspace", "Gray", "-resize", "200%", str(big)])
    out = subprocess.run(["tesseract", str(big), "-", "--psm", "3"],
                         check=True, capture_output=True, text=True).stdout
    return "\n".join(line.rstrip() for line in out.strip().splitlines())


def qr_codes(path, work=None):
    """QR/barcodes in a shot. Retries on a cleaned copy (white margin, grey,
    hard threshold): a code touching the screen edge has no quiet zone."""
    def scan(file):
        run = subprocess.run(["zbarimg", "--quiet", "--raw", str(file)], capture_output=True, text=True)
        return [line for line in run.stdout.splitlines() if line.strip()]
    codes = scan(path)
    if codes or work is None:
        return codes
    clean = work / f"{path.stem}-qr.png"
    run_magick([str(path), "-bordercolor", "white", "-border", "60", "-colorspace", "Gray",
                "-threshold", "55%", str(clean)])
    return scan(clean)


def launch(command):
    """Start a helper (editor, pin, browser, notify) and reap it when it exits,
    so a closed pin or editor doesn't linger as a zombie of the tray."""
    proc = subprocess.Popen(command, start_new_session=True,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    threading.Thread(target=proc.wait, daemon=True).start()
    return proc


def read_inherited_capture(fd, pid):
    """Output of the picker started before the re-exec: read its pipe, reap it."""
    with os.fdopen(fd, "rb") as pipe:
        out = pipe.read()
    try:
        os.waitpid(pid, 0)
    except ChildProcessError:
        pass
    return out.decode(errors="replace")


def pretty_dir(path):
    home = str(Path.home())
    text = str(path)
    return "~" + text[len(home):] if text.startswith(home) else text


