class Shotpile(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.shots = []
        self.capturing = False
        self.window = None
        self.panel_open = False
        self.busy = False
        self.format = "png"
        self.layout = "vertical"
        self.dest_dir = self.load_last_dir()
        self.countdown = 0
        self.countdown_id = 0
        self.hovered = False
        self.owning_clipboard = False
        self.clipboard = None
        self.first_capture = FIRST_CAPTURE
        self.dragging = False

    # -- lifecycle ------------------------------------------------------------

    def do_startup(self):
        Adw.Application.do_startup(self)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # The clipboard outlives the tray: after a copy this process keeps
        # serving the paste until something else is copied.
        self.clipboard = Gdk.Display.get_default().get_clipboard()
        self.clipboard.connect("changed", self.on_clipboard_changed)
        # A key press while the tray is open arrives as one of these actions,
        # over D-Bus (see forward_to_open_tray), without a second GTK process.
        for name, handler in (("shot", self.shoot), ("scroll", lambda: self.shoot("scroll")),
                              ("restore", self.restore), ("done", self.finish), ("close", self.close_tray)):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda _action, _param, run=handler: run())
            self.add_action(action)

    def do_command_line(self, command_line):
        args = command_line.get_arguments()[1:]
        command = args[0] if args else "shot"
        if command == "shot":
            if self.first_capture and not self.capturing:
                fd, pid, started = self.first_capture  # already picking: started before GTK loaded
                self.first_capture = None
                self.await_capture(lambda: read_inherited_capture(fd, pid), started)
            else:
                self.shoot()
        elif command == "scroll":
            if self.first_capture and not self.capturing:
                fd, pid, started = self.first_capture
                self.first_capture = None
                self.await_capture(lambda: read_inherited_capture(fd, pid), started)
            else:
                self.shoot("scroll")
        elif command == "restore":
            self.restore()
        elif command == "done":
            self.finish()
        elif command == "close":
            self.close_tray()
        else:
            return 2
        return 0

    def finish(self):
        if self.shots:
            self.open_panel()

    def restore(self):
        try:
            saved = [Path(line) for line in LAST_PILE_FILE.read_text().splitlines() if line.strip()]
        except OSError:
            saved = []
        saved = [p for p in saved if p.is_file() and p not in self.shots]
        if not saved and not self.shots:
            launch(["notify-send", "shotpile", "No closed pile to restore"])
            return
        self.shots = saved + self.shots
        if self.dest_dir is None and self.shots:
            self.dest_dir = self.shots[0].parent
        self.show_tray(f"restored {len(saved)} shot{'s' if len(saved) != 1 else ''}")
        self.stop_countdown()  # a restored pile waits for you

    # -- capture --------------------------------------------------------------

    def shoot(self, mode=None):
        if self.capturing:
            # Like Omarchy's own screenshot key: pressing it again mid-pick cancels.
            subprocess.run(["pkill", "-x", "slurp"])
            if shutil.which("omasnap"):
                # Omasnap's documented toggle: a second instance dismisses the overlay.
                subprocess.Popen(capture_command(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        self.stop_countdown()
        if self.window and self.window.get_visible():
            self.window.set_visible(False)
            # A couple of frames for the compositor to drop the tray before the
            # screen freezes, or the tray ends up in the shot.
            GLib.timeout_add(80, self.start_capture, mode)
        else:
            self.start_capture(mode)

    def start_capture(self, mode=None):
        started = time.time()
        try:
            proc = subprocess.Popen(capture_command(mode), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError as error:
            self.show_tray(f"capture failed: {error.strerror}", error=True)
            return GLib.SOURCE_REMOVE
        self.await_capture(lambda: proc.communicate()[0].decode(errors="replace"), started)
        return GLib.SOURCE_REMOVE

    def await_capture(self, wait, started):
        """wait() blocks until the picker finishes and returns what it printed."""
        self.capturing = True
        self.hold()

        def run():
            out = wait()
            GLib.idle_add(self.on_captured, find_capture(out, started))

        threading.Thread(target=run, daemon=True).start()

    def on_captured(self, path):
        self.capturing = False
        if path:
            self.shots.append(path)
            # Same as a normal screenshot: the newest shot is on the clipboard.
            with open(path, "rb") as image:
                subprocess.Popen(["wl-copy", "--type", "image/png"], stdin=image)
            if self.dest_dir is None:
                self.dest_dir = Path(path).parent
        if self.shots:
            self.show_tray()
        self.release()

    # -- tray -----------------------------------------------------------------

    def build_window(self):
        win = Gtk.ApplicationWindow(application=self, title="shotpile", resizable=False)
        win.add_css_class("shotpile")
        if LayerShell and LayerShell.is_supported():
            LayerShell.init_for_window(win)
            LayerShell.set_namespace(win, "shotpile")
            LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
            for edge in (LayerShell.Edge.BOTTOM, LayerShell.Edge.RIGHT):
                LayerShell.set_anchor(win, edge, True)
                LayerShell.set_margin(win, edge, 24)
            # Focus only when clicked, so capturing never steals your keyboard.
            LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.ON_DEMAND)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        win.add_controller(keys)
        hover = Gtk.EventControllerMotion()
        hover.connect("enter", lambda *_: self.set_hovered(True))
        hover.connect("leave", lambda *_: self.set_hovered(False))
        win.add_controller(hover)
        win.connect("close-request", self.on_close_request)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        card.add_css_class("sp-card")

        header = Gtk.Box(spacing=8)
        title = Gtk.Label(label="shotpile")
        title.add_css_class("title")
        mark = Gtk.Label(label="⟐")
        mark.add_css_class("mark")
        self.count_label = Gtk.Label(valign=Gtk.Align.CENTER)
        self.count_label.add_css_class("count")
        close = Gtk.Button(label="×", tooltip_text="close (esc)")
        close.add_css_class("close")
        close.connect("clicked", lambda *_: self.close_tray())
        header.append(title)
        header.append(mark)
        header.append(self.count_label)
        header.append(Gtk.Box(hexpand=True))
        header.append(close)

        self.strip = Gtk.Box(spacing=8)
        scroller = Gtk.ScrolledWindow(
            hscrollbar_policy=Gtk.PolicyType.AUTOMATIC, vscrollbar_policy=Gtk.PolicyType.NEVER,
            propagate_natural_width=True, propagate_natural_height=True,
            max_content_width=580, child=self.strip)

        self.hint = Gtk.Label(xalign=0, wrap=True, max_width_chars=52)
        self.hint.add_css_class("hint")

        actions = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        add = self.button("+ add another", lambda: self.shoot(), "or press super+shift+2")
        scroll = self.button("+ scrolling", lambda: self.shoot("scroll"), "capture a scrolling page into the pile")
        self.done_button = self.button("done", self.toggle_panel)
        self.done_button.add_css_class("accent")  # the tray's one default action
        actions.append(add)
        actions.append(scroll)
        actions.append(self.done_button)

        # Hidden, not collapsed: a collapsed panel would still set the tray's width.
        self.panel = self.build_panel()
        self.panel.set_visible(False)

        for child in (header, scroller, self.hint, actions, self.panel):
            card.append(child)
        win.set_child(Adw.Clamp(maximum_size=620, tightening_threshold=620, child=card))
        return win

    def build_panel(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)

        rule = Gtk.Label(label="⊰-•-•⟐•-•-⊱")
        rule.add_css_class("rule")
        box.append(rule)

        box.append(self.section("format"))
        box.append(self.toggle_group(FORMATS, self.format, "format"))
        box.append(self.section("stitch"))
        box.append(self.toggle_group(LAYOUTS, self.layout, "layout"))

        # Copy and save are both commit actions, so they look alike. The accent
        # marks one of them: the default at first, then whichever you last used.
        copy_all = self.button(
            "copy all", lambda: self.act(copy_all, "copying…", self.job_copy_all),
            "paste them all at once: as files in file managers and chat apps, "
            "as one stitched image where only an image is accepted")
        copy_one = self.button("copy as one image", lambda: self.act(copy_one, "stitching…", self.job_copy_stitched))
        save_all = self.button("save all", lambda: self.act(save_all, "saving…", self.job_save_all))
        save_one = self.button("save as one image", lambda: self.act(save_one, "stitching…", self.job_save_stitched))

        for label, pair in (("copy", (copy_all, copy_one)), ("save", (save_all, save_one))):
            box.append(self.section(label))
            row = Gtk.Box(spacing=8, homogeneous=True)
            for button in pair:
                row.append(button)
            box.append(row)

        dest_row = Gtk.Box(spacing=8)
        self.dest_label = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.MIDDLE,
                                    max_width_chars=36)
        self.dest_label.add_css_class("dest")
        change = self.button("change folder…", lambda: self.choose_folder())
        dest_row.append(self.dest_label)
        dest_row.append(change)
        box.append(dest_row)

        self.status = Gtk.Label(xalign=0, wrap=True, max_width_chars=52)
        self.status.add_css_class("status")
        box.append(self.status)
        self.action_buttons = [copy_all, copy_one, save_all, save_one]
        self.job_buttons = [*self.action_buttons, change]
        self.set_accent(copy_all)
        return box

    def button(self, label, handler, tooltip=None):
        button = Gtk.Button(label=label, tooltip_text=tooltip)
        button.add_css_class("sp")
        button.connect("clicked", lambda *_: handler())
        return button

    def set_accent(self, chosen):
        for button in self.action_buttons:
            if button is chosen:
                button.add_css_class("accent")
            else:
                button.remove_css_class("accent")

    def act(self, button, message, job):
        self.set_accent(button)
        self.run_job(message, job)

    def section(self, text):
        label = Gtk.Label(label=f"⟐ {text}", xalign=0)
        label.add_css_class("section")
        return label

    def toggle_group(self, options, active, attribute):
        box = Gtk.Box()
        box.add_css_class("linked")
        box.add_css_class("sp-toggles")
        first = None
        for name, label in options:
            toggle = Gtk.ToggleButton(label=label.lower())
            if first is None:
                first = toggle
            else:
                toggle.set_group(first)
            toggle.set_active(name == active)
            toggle.connect("toggled", lambda t, n=name: t.get_active() and setattr(self, attribute, n))
            box.append(toggle)
        return box

    def show_tray(self, message=None, error=False):
        if self.window is None:
            self.window = self.build_window()
        self.refresh()
        if message:
            self.set_status(message, error)
        self.window.set_visible(True)
        self.window.present()
        if len(self.shots) == 1 and not self.panel_open:
            self.start_countdown()

    def refresh(self):
        child = self.strip.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.strip.remove(child)
            child = nxt
        for index, path in enumerate(self.shots):
            self.strip.append(self.thumbnail(index, path))
        n = len(self.shots)
        self.count_label.set_label(f"{n} shot" + ("" if n == 1 else "s"))
        self.dest_label.set_label(f"saves to {pretty_dir(self.dest_dir)}" if self.dest_dir else "")
        self.update_hint()

    def thumbnail(self, index, path):
        # A downscaled texture, not the full screenshot: a Picture of a 2560x1600
        # file asks for 2560x1600 and holds ~16 MB per shot.
        pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), 360, 360, True)
        texture = Gdk.MemoryTexture.new(
            pixbuf.get_width(), pixbuf.get_height(),
            Gdk.MemoryFormat.R8G8B8A8 if pixbuf.get_has_alpha() else Gdk.MemoryFormat.R8G8B8,
            pixbuf.read_pixel_bytes(), pixbuf.get_rowstride())
        picture = Gtk.Picture.new_for_paintable(texture)
        picture.set_content_fit(Gtk.ContentFit.COVER)
        picture.set_can_shrink(True)
        picture.set_tooltip_text(f"{path.name}\nclick to edit • drag into any app")
        click = Gtk.GestureClick()
        click.connect("released", lambda *_: None if self.dragging else self.edit(path))
        picture.add_controller(click)
        # CleanShot's signature move: drag the shot itself into Chrome, Slack, Files…
        drag = Gtk.DragSource(actions=Gdk.DragAction.COPY)
        drag.connect("prepare", lambda _src, _x, _y, p=path: self.drag_content(p))
        drag.connect("drag-begin", lambda src, _drag, t=texture: self.on_drag_begin(src, t))
        drag.connect("drag-end", lambda *_: self.on_drag_end())
        picture.add_controller(drag)

        # A scrolled window that never scrolls: it sizes to its own request
        # instead of the picture's natural size, and clips the rounded corners.
        frame = Gtk.ScrolledWindow(
            hscrollbar_policy=Gtk.PolicyType.EXTERNAL, vscrollbar_policy=Gtk.PolicyType.EXTERNAL,
            child=picture)
        frame.set_size_request(150, 94)
        frame.set_overflow(Gtk.Overflow.HIDDEN)
        frame.add_css_class("thumb")

        overlay = Gtk.Overlay(child=frame)
        number = Gtk.Label(label=str(index + 1), halign=Gtk.Align.START, valign=Gtk.Align.START)
        number.add_css_class("num")
        # The newest shot is the growing edge: the only magenta on screen.
        if index == len(self.shots) - 1 and len(self.shots) > 1:
            frame.add_css_class("newest")
            number.add_css_class("newest")
        remove = Gtk.Button(label="×", halign=Gtk.Align.END,
                            valign=Gtk.Align.START, tooltip_text="leave out of the pile (the file stays)")
        remove.add_css_class("remove")
        remove.connect("clicked", lambda *_: self.drop(index))
        overlay.add_overlay(number)
        overlay.add_overlay(remove)
        # Hover actions, like CleanShot's Quick Access card.
        bar = Gtk.Box(spacing=0, halign=Gtk.Align.CENTER, valign=Gtk.Align.END)
        bar.add_css_class("hoverbar")
        for glyph, tip, handler in (
                ("\uf0c5", "copy this shot (ctrl+c on the newest)", self.copy_one),
                ("\uf040", "edit in omasnap", self.edit),
                ("\uf08d", "pin on top of every workspace (p)", self.pin),
                ("\uf031", "copy the text in it, OCR (t)", self.copy_text),
                ("\uf029", "read a QR code in it", self.read_qr),
                ("\uf0d0", "beautify: rounded, shadow, theme backdrop; replaces it in the pile", self.beautify_shot)):
            hb = Gtk.Button(label=glyph, tooltip_text=tip)
            hb.add_css_class("hb")
            hb.connect("clicked", lambda *_a, h=handler, p=path: h(p))
            bar.append(hb)
        overlay.add_overlay(bar)
        overlay.add_css_class("tile")
        # Shown by pointer motion, not CSS :hover, which never fires on this
        # layer-shell surface (measured live 2026-11-06).
        bar.set_visible(False)
        motion = Gtk.EventControllerMotion()
        motion.connect("enter", lambda *_a, b=bar: b.set_visible(True))
        motion.connect("leave", lambda *_a, b=bar: b.set_visible(False))
        overlay.add_controller(motion)
        return overlay

    # -- per-shot actions -------------------------------------------------------

    def drag_content(self, path):
        gfile = Gio.File.new_for_path(str(path))
        value = GObject.Value(Gdk.FileList, Gdk.FileList.new_from_list([gfile]))
        providers = [
            Gdk.ContentProvider.new_for_value(value),
            Gdk.ContentProvider.new_for_bytes("text/uri-list", GLib.Bytes.new((gfile.get_uri() + "\r\n").encode())),
            Gdk.ContentProvider.new_for_bytes("image/png", GLib.Bytes.new(path.read_bytes())),
        ]
        return Gdk.ContentProvider.new_union(providers)

    def on_drag_begin(self, source, texture):
        self.dragging = True
        self.stop_countdown()  # don't vanish mid-drag
        source.set_icon(texture, texture.get_width() // 2, texture.get_height() // 2)

    def on_drag_end(self):
        GLib.timeout_add(250, lambda: setattr(self, "dragging", False) or GLib.SOURCE_REMOVE)

    def copy_one(self, path):
        self.stop_countdown()
        self.put_on_clipboard([path], path.read_bytes())
        self.set_status(f"copied {path.name}")

    def pin(self, path):
        try:
            launch(["omasnap", "--pin", str(path)])
            self.set_status("pinned • close it from the pinned window")
        except OSError as error:
            self.set_status(f"couldn't pin: {error.strerror}", error=True)

    def copy_text(self, path):
        self.stop_countdown()
        self.run_side_job("reading text…", lambda: ("text", ocr_text(path, self.work_dir())))

    def read_qr(self, path):
        self.stop_countdown()
        self.run_side_job("looking for a QR code…", lambda: ("qr", qr_codes(path, self.work_dir())))

    def beautify_shot(self, path):
        self.stop_countdown()
        out = unique_path(path.with_name(f"{path.stem}-pretty.png"))
        self.run_side_job("beautifying…", lambda: ("pretty", path, beautify(path, out)))

    def run_side_job(self, message, job):
        """Per-shot work off the UI thread; shares the busy flag with pile jobs."""
        if self.busy:
            return
        self.busy = True
        self.set_status(message)

        def worker():
            try:
                outcome = job()
            except subprocess.CalledProcessError as error:
                detail = (error.stderr or b"")
                detail = detail.decode(errors="replace") if isinstance(detail, bytes) else detail
                outcome = ("error", f"{error.cmd[0]} failed: {(detail.strip().splitlines() or [''])[-1]}")
            except OSError as error:
                outcome = ("error", f"{error.strerror}: {error.filename}")
            GLib.idle_add(self.side_job_finished, outcome)

        threading.Thread(target=worker, daemon=True).start()

    def side_job_finished(self, outcome):
        self.busy = False
        kind = outcome[0]
        if kind == "error":
            self.set_status(outcome[1], error=True)
        elif kind == "text":
            text = outcome[1]
            if text:
                self.put_text(text)
                words = len(text.split())
                self.set_status(f"copied {words} word{'s' if words != 1 else ''} of text")
            else:
                self.set_status("no text found", error=True)
        elif kind == "qr":
            codes = outcome[1]
            if not codes:
                self.set_status("no QR code found", error=True)
            else:
                self.put_text("\n".join(codes))
                link = next((c for c in codes if c.startswith(("http://", "https://"))), None)
                if link:
                    launch(["xdg-open", link])
                    self.set_status(f"opened + copied {link[:48]}")
                else:
                    self.set_status(f"copied QR: {codes[0][:48]}")
        elif kind == "pretty":
            _, original, pretty = outcome
            if original in self.shots:
                self.shots[self.shots.index(original)] = pretty
            self.put_on_clipboard([pretty], pretty.read_bytes())
            self.refresh()
            self.set_status(f"beautified + copied • original kept as {original.name}")
        return GLib.SOURCE_REMOVE

    def update_hint(self):
        if self.panel_open:
            self.hint.set_label("super+shift+2 still adds shots")
        elif len(self.shots) == 1 and self.countdown_id:
            self.hint.set_label(f"saved • copied • super+shift+2 adds another • closes in {self.countdown}s")
        else:
            self.hint.set_label("super+shift+2 adds another • hover a shot for actions, drag it anywhere")

    def drop(self, index):
        if 0 <= index < len(self.shots):
            del self.shots[index]
        if self.shots:
            self.refresh()
        else:
            self.close_tray()

    def edit(self, path):
        # Omasnap is Omarchy's editor since 4.5; an override that no longer
        # exists (e.g. the old tensaku wrapper) falls through to it.
        editor = os.environ.get("OMARCHY_SCREENSHOT_EDITOR") or ""
        command = [editor, str(path)] if shutil.which(editor) and "tensaku" not in editor else ["omasnap", "--file", str(path)]
        editor = command[0]
        try:
            launch(command)
        except OSError as error:
            self.set_status(f"couldn't open {editor}: {error.strerror}", error=True)

    def toggle_panel(self):
        if self.panel_open:
            self.panel_open = False
            self.panel.set_visible(False)
            self.done_button.set_label("done")
            self.update_hint()
        else:
            self.open_panel()

    def open_panel(self):
        if self.window is None:
            self.show_tray()
        self.stop_countdown()
        self.panel_open = True
        self.panel.set_visible(True)
        self.done_button.set_label("hide")
        self.update_hint()

    def close_tray(self):
        self.stop_countdown()
        if self.shots:
            # CleanShot's "restore recently closed": `shotpile restore` brings it back.
            try:
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                LAST_PILE_FILE.write_text("".join(f"{p}\n" for p in self.shots))
            except OSError:
                pass
        if self.window:
            self.window.destroy()
            self.window = None
        self.shots = []
        self.panel_open = False

    def on_close_request(self, _window):
        self.close_tray()
        return True

    def on_key(self, _controller, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            if self.panel_open:
                self.toggle_panel()
            else:
                self.close_tray()
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and not self.panel_open:
            self.open_panel()
            return True
        newest = self.shots[-1] if self.shots else None
        ctrl = bool(_state & Gdk.ModifierType.CONTROL_MASK)
        shift = bool(_state & Gdk.ModifierType.SHIFT_MASK)
        if newest is None:
            return False
        if ctrl and keyval in (Gdk.KEY_c, Gdk.KEY_C):
            if shift and len(self.shots) > 1:
                self.run_job("copying…", self.job_copy_all)
            else:
                self.copy_one(newest)
            return True
        if keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
            self.drop(len(self.shots) - 1)
            return True
        if not ctrl and keyval in (Gdk.KEY_p, Gdk.KEY_P):
            self.pin(newest)
            return True
        if not ctrl and keyval in (Gdk.KEY_t, Gdk.KEY_T):
            self.copy_text(newest)
            return True
        return False

    # A lone shot's tray closes by itself, like a notification; hovering pauses it.
    def start_countdown(self):
        self.stop_countdown()
        self.countdown = SINGLE_SHOT_SECONDS
        self.countdown_id = GLib.timeout_add_seconds(1, self.tick)
        self.update_hint()

    def stop_countdown(self):
        if self.countdown_id:
            GLib.source_remove(self.countdown_id)
            self.countdown_id = 0

    def tick(self):
        if self.hovered:
            return GLib.SOURCE_CONTINUE
        self.countdown -= 1
        if self.countdown <= 0:
            self.countdown_id = 0
            self.close_tray()
            return GLib.SOURCE_REMOVE
        self.update_hint()
        return GLib.SOURCE_CONTINUE

    def set_hovered(self, hovered):
        self.hovered = hovered

    # -- jobs -----------------------------------------------------------------

    def work_dir(self):
        path = RUN_DIR / time.strftime("%Y%m%d-%H%M%S")
        path.mkdir(parents=True, exist_ok=True)
        return path

    def run_job(self, message, job):
        if self.busy or not self.shots:
            return
        self.busy = True
        for button in self.job_buttons:
            button.set_sensitive(False)
        self.set_status(message)
        shots, fmt, layout, dest = list(self.shots), self.format, self.layout, self.dest_dir

        def worker():
            try:
                outcome = job(shots, fmt, layout, dest)
            except subprocess.CalledProcessError as error:
                detail = (error.stderr or b"").decode(errors="replace").strip().splitlines()
                outcome = ("error", "imagemagick failed: " + (detail[-1] if detail else str(error)))
            except OSError as error:
                outcome = ("error", f"{error.strerror}: {error.filename}")
            GLib.idle_add(self.job_finished, outcome)

        threading.Thread(target=worker, daemon=True).start()

    def job_finished(self, outcome):
        self.busy = False
        for button in self.job_buttons:
            button.set_sensitive(True)
        kind = outcome[0]
        if kind == "error":
            self.set_status(outcome[1], error=True)
        elif kind == "copy":
            _, files, png, message = outcome
            self.put_on_clipboard(files, png)
            self.set_status(message)
        else:
            self.set_status(outcome[1])
        return GLib.SOURCE_REMOVE

    def job_copy_all(self, shots, fmt, layout, _dest):
        work = self.work_dir()
        files = shots if fmt == "png" else [convert(s, work / f"{s.stem}.{fmt}") for s in shots]
        stitched = stitch(shots, layout, work / "stitched.png")
        n = len(files)
        return ("copy", files, stitched.read_bytes(),
                f"copied {n} {fmt} file{'s' if n != 1 else ''} • paste anywhere")

    def job_copy_stitched(self, shots, fmt, layout, _dest):
        work = self.work_dir()
        png = stitch(shots, layout, work / "stitched.png")
        out = png if fmt == "png" else convert(png, work / f"shotpile-{time.strftime('%H%M%S')}.{fmt}")
        return ("copy", [out], png.read_bytes(), f"copied one stitched {fmt} image")

    def job_save_all(self, shots, fmt, _layout, dest):
        dest.mkdir(parents=True, exist_ok=True)
        written = 0
        for shot in shots:
            if shot.parent == dest and shot.suffix.lower() == f".{fmt}":
                continue  # already there, as a screenshot is saved on capture
            convert(shot, unique_path(dest / f"{shot.stem}.{fmt}"))
            written += 1
        self.save_last_dir(dest)
        if written == 0:
            return ("ok", f"all {len(shots)} already in {pretty_dir(dest)}")
        return ("ok", f"saved {written} to {pretty_dir(dest)}")

    def job_save_stitched(self, shots, fmt, layout, dest):
        dest.mkdir(parents=True, exist_ok=True)
        out = stitch(shots, layout, unique_path(dest / f"shotpile-{time.strftime('%Y-%m-%d_%H-%M-%S')}.{fmt}"))
        self.save_last_dir(dest)
        return ("ok", f"saved {out.name} to {pretty_dir(dest)}")

    # -- clipboard ------------------------------------------------------------

    def put_on_clipboard(self, files, png):
        """Offer the pile in every form a paste target might want: a file list
        (chat apps, browsers, GTK apps), GNOME's copied-files (Nautilus), and one
        stitched PNG for targets that accept only an image. Each app takes the
        richest one it understands."""
        uris = [Gio.File.new_for_path(str(f)).get_uri() for f in files]
        providers = [
            Gdk.ContentProvider.new_for_bytes(
                "text/uri-list", GLib.Bytes.new(("\r\n".join(uris) + "\r\n").encode())),
            Gdk.ContentProvider.new_for_bytes(
                "x-special/gnome-copied-files", GLib.Bytes.new(("copy\n" + "\n".join(uris)).encode())),
            Gdk.ContentProvider.new_for_bytes("image/png", GLib.Bytes.new(png)),
        ]
        self.clipboard.set_content(Gdk.ContentProvider.new_union(providers))
        if not self.owning_clipboard:
            self.owning_clipboard = True
            self.hold()  # stay alive to serve the paste until something else is copied

    def put_text(self, text):
        data = GLib.Bytes.new(text.encode())
        self.clipboard.set_content(Gdk.ContentProvider.new_union([
            Gdk.ContentProvider.new_for_bytes("text/plain;charset=utf-8", data),
            Gdk.ContentProvider.new_for_bytes("text/plain", data),
            Gdk.ContentProvider.new_for_bytes("UTF8_STRING", data)]))
        if not self.owning_clipboard:
            self.owning_clipboard = True
            self.hold()

    def on_clipboard_changed(self, clipboard):
        if self.owning_clipboard and not clipboard.get_property("local"):
            self.owning_clipboard = False
            self.release()

    # -- folders --------------------------------------------------------------

    def choose_folder(self, *_):
        dialog = Gtk.FileDialog(title="Save shots to…")
        if self.dest_dir:
            dialog.set_initial_folder(Gio.File.new_for_path(str(self.dest_dir)))
        self.hold()
        dialog.select_folder(None, None, self.on_folder_chosen)

    def on_folder_chosen(self, dialog, result):
        self.release()
        try:
            folder = dialog.select_folder_finish(result)
        except GLib.Error:
            return  # cancelled
        if folder and folder.get_path():
            self.dest_dir = Path(folder.get_path())
            self.save_last_dir(self.dest_dir)
            if self.window:
                self.refresh()

    def load_last_dir(self):
        try:
            path = Path(LAST_DIR_FILE.read_text().strip())
            return path if path.is_dir() else None
        except OSError:
            return None

    def save_last_dir(self, path):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        LAST_DIR_FILE.write_text(f"{path}\n")

    def set_status(self, text, error=False):
        if not self.window:
            return
        self.status.set_label(text)
        for label in (self.status, self.hint):
            if error:
                label.add_css_class("error")
            else:
                label.remove_css_class("error")
        if not self.panel_open:
            # The panel's status line is hidden while the panel is closed, so
            # per-shot actions report in the hint line for a few seconds.
            self.hint.set_label(text)
            self.hint.add_css_class("status")
            GLib.timeout_add_seconds(4, self.reset_hint)

    def reset_hint(self):
        if self.window:
            self.hint.remove_css_class("status")
            self.hint.remove_css_class("error")
            self.update_hint()
        return GLib.SOURCE_REMOVE


if __name__ == "__main__":
    sys.exit(Shotpile().run(sys.argv))
