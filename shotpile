#!/usr/bin/env python3
"""shotpile: take several screenshots in a row, then choose how to copy or save the pile.

Usage:
  shotpile [shot]   take a screenshot; while the tray is open, add another
  shotpile scroll   take a scrolling screenshot into the pile
  shotpile restore  reopen the last pile you closed
  shotpile done     open the copy / save panel
  shotpile close    close the tray
  shotpile selftest check the capture still works (run after Omarchy updates)

Each thumbnail can be dragged into any app, and hovering it shows
copy / edit / pin / text (OCR) / QR / beautify. Tray keys: Ctrl+C newest,
Ctrl+Shift+C whole pile, Delete drop newest, P pin, T text, Enter done, Esc close.

Capture goes through Omarchy's Omasnap (`omasnap <mode> --save`), so the
region picker, screen freeze and output folder are exactly the ones a normal
screenshot uses. Every shot is saved there the moment it is taken, and the newest
one is on the clipboard, as with a normal screenshot: closing the tray loses
nothing.
"""

import math
import os
import shutil
import subprocess
import sys
import threading
import time
from pathlib import Path

APP_ID = "io.github.blurxy.shotpile"
OBJECT_PATH = "/" + APP_ID.replace(".", "/")


def capture_command(mode=None):
    # 2026-11-06: Omarchy 4.5 replaced Tensaku with Omasnap. Call omasnap directly:
    # omarchy-capture-screenshot adds --notify, which would pop a second toast on
    # top of the tray. Older Omarchy (no omasnap) keeps the old route.
    mode = mode or os.environ.get("SHOTPILE_MODE", "smart")
    if shutil.which("omasnap"):
        return ["omasnap", mode, "--save"]
    return ["omarchy-capture-screenshot", mode, "save"]


def screenshot_dir():
    for var in ("OMASNAP_SCREENSHOT_DIR", "OMARCHY_SCREENSHOT_DIR"):
        if os.environ.get(var):
            return Path(os.path.expanduser(os.environ[var]))
    try:
        pictures = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True,
                                  text=True, timeout=2).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pictures = ""
    return Path(pictures or os.path.expanduser("~/Pictures")) / "Screenshots"


def find_capture(out, started):
    """The file a capture produced. Tensaku printed its path; Omasnap prints
    nothing, so fall back to the newest image saved since the capture began.
    Esc/cancel saves nothing, so this correctly returns None then."""
    lines = [line.strip() for line in (out or "").splitlines() if line.strip()]
    if lines and os.path.isfile(lines[-1]):
        return Path(lines[-1])
    folder = screenshot_dir()
    try:
        fresh = [f for f in folder.iterdir()
                 if f.suffix.lower() in (".png", ".jpg", ".jpeg", ".webp")
                 and f.stat().st_mtime >= started - 1]
    except OSError:
        return None
    return max(fresh, key=lambda f: f.stat().st_mtime) if fresh else None


# ---- fast path ----------------------------------------------------------------
# Loading GTK and libadwaita takes ~300 ms, which would sit between the key press
# and the region picker. So the first shot starts its picker before anything
# heavy loads, and a press while a tray is open reaches it over D-Bus (~100 ms,
# was ~450). Measured on the power-saver profile: Omarchy's own picker appears
# in 320-360 ms, shotpile's in ~380-410. (A 168 ms figure for Omarchy was taken
# while the CPU was boosted; compare the two under the same profile.)


def find_layer_shell():
    # Checked by path first: `import ctypes.util` alone costs ~56 ms here.
    for directory in ("/usr/lib", "/usr/lib64", "/usr/local/lib", "/usr/lib/x86_64-linux-gnu"):
        candidate = os.path.join(directory, "libgtk4-layer-shell.so.0")
        if os.path.exists(candidate):
            return candidate
    import ctypes.util
    return ctypes.util.find_library("gtk4-layer-shell")


def forward_to_open_tray(command):
    """If a shotpile tray is running, hand it the command and exit."""
    try:
        owned = subprocess.run(
            ["gdbus", "call", "--session", "--dest", "org.freedesktop.DBus",
             "--object-path", "/org/freedesktop/DBus",
             "--method", "org.freedesktop.DBus.NameHasOwner", APP_ID],
            capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return  # no gdbus: GApplication's own remote path still works, just slower
    if "true" in owned:
        subprocess.run(
            ["gdbus", "call", "--session", "--dest", APP_ID, "--object-path", OBJECT_PATH,
             "--method", "org.gtk.Actions.Activate", command, "[]", "{}"],
            capture_output=True, timeout=2)
        sys.exit(0)


def start_first_capture(mode=None):
    """Start the picker now. Its output pipe is left inheritable so it survives
    the re-exec below; the child keeps running as ours (exec keeps the PID)."""
    read_fd, write_fd = os.pipe()
    child = subprocess.Popen(capture_command(mode), stdout=write_fd, stderr=subprocess.DEVNULL)
    os.close(write_fd)
    os.set_inheritable(read_fd, True)
    os.environ["SHOTPILE_CAPTURE"] = f"{read_fd}:{child.pid}:{time.time()}"


def preload_layer_shell():
    """gtk4-layer-shell must be loaded before libwayland-client. A Python process
    can only arrange that by restarting itself with the library in LD_PRELOAD."""
    library = find_layer_shell()
    if not library:
        return
    os.environ["SHOTPILE_PRELOADED"] = "1"
    os.environ["LD_PRELOAD"] = " ".join(filter(None, [library, os.environ.get("LD_PRELOAD")]))
    os.execv(sys.executable, [sys.executable, *sys.argv])


def selftest():
    """Take one silent fullscreen shot into a temp folder and check shotpile can
    find it, i.e. the capture contract still holds. Run after Omarchy updates
    (~/.config/omarchy/hooks/post-update.d/shotpile-selftest.hook): the 4.5
    update broke it silently on 2026-11-06 (Omasnap prints no path). No GTK."""
    import tempfile
    problems = []
    for tool in ("wl-copy", "omasnap"):
        if not shutil.which(tool):
            problems.append(f"{tool} not found")
    with tempfile.TemporaryDirectory(prefix="shotpile-selftest-") as folder:
        env = dict(os.environ, SHOTPILE_MODE="fullscreen", OMASNAP_SCREENSHOT_DIR=folder)
        os.environ.update(SHOTPILE_MODE="fullscreen", OMASNAP_SCREENSHOT_DIR=folder)
        started = time.time()
        try:
            run = subprocess.run(capture_command(), capture_output=True, text=True, timeout=20, env=env)
            path = find_capture(run.stdout, started)
            if run.returncode != 0:
                problems.append(f"{' '.join(capture_command())} exited {run.returncode}: {run.stderr.strip()[:200]}")
            elif not path:
                problems.append(f"capture ran but no image appeared in {folder}")
        except (OSError, subprocess.TimeoutExpired) as error:
            problems.append(f"capture failed: {error}")
    if problems:
        print("shotpile selftest FAILED:\n  " + "\n  ".join(problems))
        return 1
    print("shotpile selftest OK")
    return 0


FIRST_CAPTURE = None  # (read fd, pid) of a picker started before GTK loaded

if __name__ == "__main__":
    COMMAND = sys.argv[1] if len(sys.argv) > 1 else "shot"
    if COMMAND == "selftest":
        sys.exit(selftest())
    if COMMAND not in ("shot", "scroll", "restore", "done", "close"):
        sys.exit(f"usage: shotpile [shot|scroll|restore|done|close|selftest]  (got {COMMAND!r})")
    if not os.environ.get("SHOTPILE_PRELOADED"):
        forward_to_open_tray(COMMAND)
        if COMMAND in ("done", "close"):
            sys.exit(0)  # no tray open: nothing to finish or close
        if COMMAND in ("shot", "scroll"):
            start_first_capture("scroll" if COMMAND == "scroll" else None)
        preload_layer_shell()
    # Only this process needs these; magick, wl-copy and the capture script don't.
    os.environ.pop("LD_PRELOAD", None)
    os.environ.pop("SHOTPILE_PRELOADED", None)
    if os.environ.get("SHOTPILE_CAPTURE"):
        fd, pid, started = os.environ.pop("SHOTPILE_CAPTURE").split(":")
        FIRST_CAPTURE = (int(fd), int(pid), float(started))

